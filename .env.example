# Copy to .env locally — never commit real values (repo is public).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shared remote DB (Turso). When set, Windows + this Mac + Actions write here.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Gemini (detail PDF/HTML → StructuredCriteria). Create key:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional; default gemini-2.5-flash is fine for nightly TR announcements.
GEMINI_MODEL=gemini-2.5-flash
# Call Gemini only if regex confidence is below this (saves tokens).
# Tonight / full-Gemini mode: set ATAMA_LLM_FORCE=1 (ignores conf gate).
ATAMA_LLM_MIN_CONF=0.55
ATAMA_LLM_FORCE=1
# Max chars of announcement text sent to Gemini (head + keyword windows).
ATAMA_LLM_MAX_CHARS=10000
